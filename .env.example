PORT=3010
APP_URL=http://localhost:3010
# Register this exact redirect URL: http://localhost:3010/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Required in production: 64 hex characters from node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_KEY=
# Optional paid runtime interpretation. Disabled until explicitly enabled by the operator.
ENABLE_MODEL=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
